{
  "buildCommand": "pip install -r requirements.txt && python school_crm/manage.py collectstatic --noinput --ignore=admin",
  "outputDirectory": "school_crm/staticfiles",
  "env": {
    "PYTHONUNBUFFERED": "1",
    "DJANGO_SETTINGS_MODULE": "school_crm.settings"
  },
  "functions": {
    "school_crm/school_crm/wsgi.py": {
      "runtime": "python3.11"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "school_crm/school_crm/wsgi.py"
    }
  ]
}
